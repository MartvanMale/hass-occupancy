# Python's leavings and what a local run drops in the tree; these belong in /data inside the container.
__pycache__/
*.py[cod]
.pytest_cache/
*.db
*.db-wal
*.db-shm
*.parquet

# Fitted models. Same story: they live in /data, but a local
# `python -m occupancy_forecast.train` run will drop them here.
*.pkl
models/

# Raw data by another name: a notebook carries its OUTPUTS, and an analysis of
# one household's archive prints that household's movements cell by cell. The
# research lives outside the repo -- see DEVELOPMENT.md's "Never".
*.ipynb
notebooks/

# The panel's toolchain. The built bundle IS committed -- DEVELOPMENT.md ("The panel") says why.
node_modules/

# Maintainer-machine agent instructions; the shared contract is DEVELOPMENT.md.
# Case matters on Linux.
CLAUDE.md

# The local demo instance (compose.yaml). `.env.example` is the tracked half;
# the two directories are regenerable.
.env
demo-data/
demo-shots/

# NOT ignored, deliberately: occupancy-forecast/ is generated by promote.sh but
# tracked in full, because it is what the HA box builds. Edit the originals in
# occupancy-forecast-edge/.
