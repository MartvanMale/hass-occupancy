# Editor-side half of the line-ending and whitespace policy; .gitattributes is
# the half git enforces. Advisory only -- it acts when a file is opened and
# saved, so it cannot catch a bad commit, only stop one being written.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[{*.py,*.sh,Dockerfile}]
indent_size = 4

# IBM Plex's licence verbatim, CRLF as shipped. It is inside the
# panel/dist/.source-hash input set, so a save that trims or re-ends it fails
# scripts/test.sh on both trees -- before git ever sees the edit.
[OFL.txt]
end_of_line = crlf
insert_final_newline = false
trim_trailing_whitespace = false
