# Settings for compose.yaml, the local demo. Copy to `.env`, which is gitignored
# because this repository is public and what goes in it is one machine's.

# Where the fictional household's /data lives. Create it before the first run:
# Docker creates a missing bind-mount source as root and the containers run unprivileged.
DEMO_DATA=./demo-data

# Where `capture` writes its PNGs.
SHOTS_DIR=./demo-shots

# 127.0.0.1 keeps the panel on this machine; a LAN address opens it elsewhere.
# Not 8099 -- that is the port inside the container.
DEMO_BIND=127.0.0.1
DEMO_PORT=8100

# Whoever owns DEMO_DATA and SHOTS_DIR, so the files the containers write stay
# readable and deletable without sudo. `id -u` and `id -g`.
DEMO_UID=1000
DEMO_GID=1000

# Only affects timestamps in the container's logs. The demo household's own
# timezone comes from its config.json, not from here.
TZ=Etc/UTC
