# Settings for compose.yaml, the local demo instance. Copy to `.env` and edit.
#
# `.env` is gitignored because what goes in it is specific to one machine -- an
# address on somebody's LAN, a path in somebody's home directory -- and this
# repository is public.

# Where the fictional household's /data lives on the host. Create it before the
# first `docker compose run`: Docker creates a missing bind-mount source as
# root, and the containers run unprivileged, so an auto-created one is not
# writable. Keeping it outside the repository is the safer default -- the state
# is 25-odd MB of archive, parquet and pickles that no clone wants.
DEMO_DATA=./demo-data

# Where `capture` writes its PNGs.
SHOTS_DIR=./demo-shots

# The published port. 127.0.0.1 keeps the panel on this machine; set the box's
# LAN address instead to open it from a browser elsewhere. Not 8099: that is the
# port inside the container, and a development box often has it taken already.
DEMO_BIND=127.0.0.1
DEMO_PORT=8100

# Whoever owns DEMO_DATA and SHOTS_DIR, so the files the containers write stay
# readable and deletable without sudo. `id -u` and `id -g`.
DEMO_UID=1000
DEMO_GID=1000

# Only affects timestamps in the container's logs. The demo household's own
# timezone comes from its config.json, not from here.
TZ=Etc/UTC
