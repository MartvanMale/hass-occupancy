#!/usr/bin/env bash
# Refuse to commit an edit to the generated stable tree.
#
# `occupancy-forecast/` is produced from `occupancy-forecast-edge/` by scripts/promote.sh.
# An edit made directly in the stable tree survives only until the next
# promotion, which overwrites it with no warning and no trace -- so the code
# running on the HA box would exist nowhere else and then quietly stop existing.
#
# CLAUDE.md says this in prose. Prose does not stop anybody at 1am. This does.
#
# scripts/promote.sh tells you to commit with PROMOTE=1, which is the intended
# way through. If you are hitting this hook without having run promote.sh, the
# fix is to make the change in occupancy-forecast-edge/ instead -- not to set the
# variable.
#
# It also refuses to commit a panel source edit without the rebuilt bundle.
# `panel/dist/` is committed -- the Dockerfile only COPYs it and a store install
# is a git clone -- so a stale bundle is not a build error but an add-on that
# serves last week's panel and says nothing about it.
#
# Enable with:  git config core.hooksPath .githooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# The panel check runs BEFORE the PROMOTE escape below, and for both trees: a
# promotion commit carries stable's freshly built bundle and is exactly as able
# to carry a stale one.
#
# It checks the WORKING TREE, not the index, so `git commit` of a partially
# staged panel can still get a mismatched pair through. That is the same
# character of guard as the rest of this hook -- it stops the 1am mistake, it is
# not a proof -- and closing it would mean checking out the index to a temp dir
# on every commit.
for tree in occupancy-forecast-edge occupancy-forecast; do
    staged_panel=$(git diff --cached --name-only --diff-filter=ACMRD \
                   -- "$tree/panel/src" "$tree/panel/index.html" \
                      "$tree/panel/package.json" "$tree/panel/package-lock.json" \
                      "$tree/panel/tsconfig.json" "$tree/panel/vite.config.ts" || true)
    [[ -n "$staged_panel" ]] || continue

    if ! scripts/check-panel.sh "$tree"; then
        echo >&2
        echo "pre-commit: $tree/panel source is staged but its committed bundle" >&2
        echo "            does not match it. Rebuild and stage dist/ too." >&2
        exit 1
    fi
done

if [[ "${PROMOTE:-}" == "1" ]]; then
    exit 0
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR -- 'occupancy-forecast/*' \
         | grep -vE '^occupancy-forecast/(config\.yaml|DOCS\.md|CHANGELOG\.md)$' || true)

if [[ -n "$staged" ]]; then
    echo "pre-commit: refusing to commit edits to the GENERATED stable tree." >&2
    echo >&2
    printf '  %s\n' $staged >&2
    echo >&2
    echo "occupancy-forecast/ is generated from occupancy-forecast-edge/ by scripts/promote.sh." >&2
    echo "Make the change in occupancy-forecast-edge/ instead." >&2
    echo >&2
    echo "If this IS a promotion, promote.sh will have told you to use:" >&2
    echo "  PROMOTE=1 git commit ..." >&2
    exit 1
fi
